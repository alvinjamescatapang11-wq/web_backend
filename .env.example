# Copy this file to .env and update the values below

# Application Settings
APP_NAME=AGRI-TRACK
APP_KEY=
APP_ENV=development
APP_TIMEZONE=Asia/Manila

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# Configure an initial CAO Administrator before running the bootstrap seeder.
AGRI_ADMIN_EMAIL=
AGRI_ADMIN_PASSWORD=
AGRI_ADMIN_NAME=

# Optional secrets for LavaLust's legacy API helper (disabled by default).
APP_JWT_SECRET=
APP_REFRESH_TOKEN_KEY=

# Exact frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
